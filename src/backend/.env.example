# Copy to .env and adjust. Never commit .env.

# Folder with books.json, item_embeddings.npy, coords_2d.npy, meta.json
ARTIFACT_DIR=sample_artifacts

# JSON-lines file for anonymous feedback votes
FEEDBACK_PATH=feedback/feedback.jsonl

# Comma-separated allowed browser origins; "*" during development only
CORS_ORIGINS=*

# Port (Cloud Run sets this automatically)
PORT=9000
